<mujoco>
  <option timestep="0.001"/>
  <option gravity="0 0 -9.81"/>
  <option density="1.225" viscosity="0.00002" wind="0 0 0"/>
  
  <worldbody>
    <!-- Lighting and Ground -->
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="10 10 0.1" rgba=".9 .9 .9 1"/>
    <camera name="my_cam" pos="0 -10 2" euler="90 0 0"/>
    
    <!-- Rocket Model -->
    <body name="rocket" pos="0 0 3">
      <joint type="free"/>
      <geom type="cylinder" size="0.1 0.5" rgba="1 0 0 1" mass="1.0"/>
      <site name="imu_site" pos="0 0 0"/>
      <body name="gimbal_pitch" pos="0 0 -0.5">
        <joint name="gimbal_y" type="hinge" axis="0 1 0" range="-0.26 0.26" damping="0.5"/>
        <geom type="cylinder" size="0.085 0.02" rgba="0.4 0.4 0.4 1" mass="0.025" contype="0" conaffinity="0"/>
        <body name="gimbal_yaw" pos="0 0 0">
          <joint name="gimbal_x" type="hinge" axis="1 0 0" range="-0.26 0.26" damping="0.5"/>
          <geom type="cylinder" size="0.08 0.1" pos="0 0 -0.05" rgba="0.3 0.3 0.3 1" mass="0.025" contype="0" conaffinity="0"/>
          <site name="thrust_site" pos="0 0 -0.1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <sensor>
    <accelerometer name="body_accel" site="imu_site"/>
    <gyro name="body_gyro" site="imu_site"/>
    <magnetometer name="body_mag" site="imu_site"/>
  </sensor>
  <actuator>
    <position joint="gimbal_x" kp="50" ctrlrange="-0.26 0.26" ctrllimited="true"/>
    <position joint="gimbal_y" kp="50" ctrlrange="-0.26 0.26" ctrllimited="true"/>
    <motor site="thrust_site" gear="0 0 1 0 0 0" forcerange="0 20" forcelimited="true"/>
  </actuator>
</mujoco>