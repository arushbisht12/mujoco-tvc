<mujoco>
  <option gravity="0 0 -9.81"/>
  
  <worldbody>
    <camera name="my_cam" pos="0 0 10" euler="0 0 0"/>
    <light diffuse=".5 .5 .5" pos="0 0 10" dir="0 0 -1"/>
    <geom type="plane" size="8 8 0.1" rgba=".9 .9 .9 1"/>
    
    <body name="chassis" pos="0 0 0">
      <joint type="free" axis="-1 0 0" pos="0 0 -0.5"/>
      <geom type="box" size="0.5 1 0.1" rgba="1 1 0 1"/>
      <site name="marker" pos = "0 0 0.1" size="0.1"/>
      <body name="wheel1" pos="0.6 -1 0" euler="0 90 0">
        <joint name="wheel1" type="hinge" axis="0 0 1" pos="0 0 0"/>
        <geom type="cylinder" size="0.25 0.1" rgba= "1 1 1 1" />
      </body>

      <body name="wheel2" pos="-0.60 -1 0" euler="0 90 0">
        <joint name="wheel2" type="hinge" axis="0 0 1" pos="0 0 0"/>
        <geom type="cylinder" size="0.25 0.1" rgba= "1 1 1 1" />
      </body>
    </body>
  </worldbody>
  <sensor>
    <framepos objtype="site" objname="marker"/>
  </sensor>
  <actuator>
    <velocity name="left-velocity-servo" joint="wheel1" kv="100"/>
    <velocity name="right-velocity-servo" joint="wheel2" kv="100"/>
  </actuator>
</mujoco>